# Environment: development or production
APP_ENV=development

# Leave blank for local development. Set a long random value in a deployed environment.
API_KEY=

# Policy thresholds
RISK_THRESHOLD_WARN=30
RISK_THRESHOLD_BLOCK=60
WEIGHT_INSTRUCTION_OVERRIDE=40
CAP_INSTRUCTION_OVERRIDE=60
WEIGHT_ROLE_MANIPULATION=30
CAP_ROLE_MANIPULATION=30
WEIGHT_SYSTEM_PROMPT_EXTRACTION=40
CAP_SYSTEM_PROMPT_EXTRACTION=40
WEIGHT_OBFUSCATION_ENCODING=15
CAP_OBFUSCATION_ENCODING=30
MAX_DECODING_DEPTH=3
MAX_REQUEST_BYTES=1000000
MAX_TEXT_LENGTH=100000

# Comma-separated exact hostnames or parent domains for egress URL checks.
ALLOWED_HOSTS=example.com,trusted.example.com
# Optional comma-separated canary strings; never use real credentials here.
CANARY_SECRETS=replace-with-a-non-production-canary

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AUDIT_LOG_FILE=firewall_audit.log
